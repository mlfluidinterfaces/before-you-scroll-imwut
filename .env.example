# Copy this file to .env and fill in your own values.
# Never commit real secrets - .env is gitignored.

# Supabase (find in your Supabase project dashboard > Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Sentry (optional - find in Sentry project settings)
# If empty, Sentry error reporting is disabled.
EXPO_PUBLIC_SENTRY_DSN=

# EAS / Expo Updates (optional - find in expo.dev dashboard)
# Used by app.config.js for updates + EAS project linkage.
EAS_PROJECT_ID=your-eas-project-id
EXPO_UPDATES_URL=https://u.expo.dev/your-eas-project-id

# Sentry Expo plugin (optional - used by app.config.js)
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
