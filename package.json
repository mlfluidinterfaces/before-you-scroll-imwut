{
  "name": "screentimeapp",
  "main": "expo-router/entry",
  "version": "1.0.51",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "eas-build-post-install": "cp \"$GOOGLE_SERVICES_JSON\" ./android/app/google-services.json",
    "prebuild:android": "node scripts/bump-version.js patch",
    "build": "node scripts/bump-version.js patch && cd android && ./gradlew assembleRelease",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "update": "eas update --auto --platform android && update:production",
    "update:production": "eas update --branch production --message \"Production update\" --platform android",
    "update:preview": "eas update --branch preview --message \"Preview update\" --platform android",
    "update:development": "eas update --branch development --message \"Development update\" --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-community/datetimepicker": "^8.5.0",
    "@react-native-community/slider": "4.5.6",
    "@react-native-firebase/app": "^23.1.0",
    "@react-native-firebase/app-distribution": "^23.1.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@sentry/react-native": "^6.14.0",
    "@supabase/supabase-js": "^2.53.0",
    "@tanstack/react-form": "^1.23.7",
    "expo": "~53.0.23",
    "expo-application": "~6.1.5",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.7",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-notifications": "~0.31.4",
    "expo-router": "~5.1.7",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-updates": "^0.28.17",
    "expo-web-browser": "~14.2.0",
    "lucide-react": "^0.552.0",
    "lucide-react-native": "^0.552.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-uuid": "^2.0.3",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/pg": "^8.15.6",
    "@types/react": "~19.0.10",
    "ajv": "^8.17.1",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3"
  },
  "private": true
}
